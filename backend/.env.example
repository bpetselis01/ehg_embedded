# Local development credentials. Copy to .env (gitignored). Change ALL of these before any cloud deployment.
# PURPOSE: Names and passwords shared by every backend service.
# BEFORE -> AFTER: Read by backend/docker-compose.yml (passed to influxdb, ingest, grafana) and by
#   eval/backend_client.py (to query InfluxDB from the laptop).
INFLUX_ORG=thesis
INFLUX_BUCKET=ehg
INFLUX_TOKEN=dev-token-change-me
INFLUX_ADMIN_PASSWORD=dev-password-change-me
GRAFANA_ADMIN_PASSWORD=admin
