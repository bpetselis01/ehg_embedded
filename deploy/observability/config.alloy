// PURPOSE: Grafana Alloy: ship the systemd journal to Loki. Docker's log driver is journald (cloud-init), so every container's log lines are in the journal with their
//   container name; Alloy reads ONLY the journal. It does not mount Docker's data directory (that holds every container's environment, including the database
//   passwords) and it does not mount the Docker socket (root-equivalent on the host).
// INPUT: /var/log/journal and /etc/machine-id (mounted read-only). OUTPUT: log lines pushed to http://loki:3100 with the labels container (Docker's name) and unit.
// HOW: loki.relabel turns the journal fields CONTAINER_NAME and _SYSTEMD_UNIT into labels; everything else is dropped from the label set.
// STATUS: UNVERIFIED against the pinned Alloy version (nobody has started it yet). The Alloy process must be able to read the journal files (they belong to the group
//   systemd-journal); if it cannot, add that group to the service with group_add using the numeric id (getent group systemd-journal on the VM).
// ROLE IN THESIS: Centralised logs (docs/decisions/0016-observability-and-slos.md).
// BEFORE -> AFTER: Before: nothing collects logs. After: Loki has them, searchable by container name.
loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal_container_name"]
    target_label  = "container"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
}

loki.source.journal "system" {
  path          = "/var/log/journal"
  labels        = {job = "journal"}
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
