// Grafana Alloy: ship the systemd journal to Loki.
loki.relabel "journal" {
  forward_to = []

  // keep ONLY entries that carry a Docker container name: sshd, sudo, login and every other host log line is dropped here, before anything is sent to Loki
  rule {
    source_labels = ["__journal_container_name"]
    regex         = ".+"
    action        = "keep"
  }

  rule {
    source_labels = ["__journal_container_name"]
    target_label  = "container"
  }

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
}

loki.source.journal "system" {
  path          = "/var/log/journal"
  labels        = {job = "journal"}
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
