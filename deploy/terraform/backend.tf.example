# Example of keeping Terraform state in OCI Object Storage through its S3-compatible API.
terraform {
  backend "s3" {
    bucket = "ehg-terraform-state"
    key    = "ehg/terraform.tfstate"
    region = "ap-sydney-1"

    endpoints = {
      s3 = "https://REPLACE_NAMESPACE.compat.objectstorage.ap-sydney-1.oraclecloud.com"
    }

    skip_region_validation      = true
    skip_credentials_validation = true
    skip_requesting_account_id  = true
    skip_metadata_api_check     = true
    skip_s3_checksum            = true
    use_path_style              = true
  }
}
