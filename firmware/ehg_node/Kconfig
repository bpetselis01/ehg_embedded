# PURPOSE: Our own build settings (with defaults), next to Zephyr's.
# HOW: Each "config" becomes a CONFIG_EHG_* constant in the C code. Change a value in prj.conf.
# ROLE IN THESIS: The experiment knobs: latency vs efficiency (H1), how much loss can be recovered (H2).
# BEFORE -> AFTER: Read at build time. Used in replay.c (queue sizes) and ehg_service.c
#   (frames per packet, history size).
source "Kconfig.zephyr"

menu "EHG node"

config EHG_FRAMES_PER_PACKET
	int "Frames batched into one BLE notification"
	default 10
	help
	  More frames per packet = fewer, bigger packets, but more waiting (report 6.8, [16]).
	  At 20 Hz, 10 frames = 0.5 s wait. 20-byte header + samples must fit 244 bytes.

config EHG_RING_FRAMES
	int "Ring buffer capacity between injection and packetiser (frames)"
	default 256
	help
	  How many frames can wait if sending falls behind (256 = 12.8 s at 20 Hz).
	  When full, new frames are dropped and counted as ring_overflow (replay.c).

config EHG_BAKED_RECORD
	bool "Built-in recording instead of the serial feed"
	help
	  y = the recording in src/replay_data.h (tools/make_replay.py) is compiled in and played on
	  START, so the board runs stand-alone. n (default) = tools/feed.py streams it over serial.
	  Set by firmware/build.sh: --record <npz> gives y, otherwise n.

config EHG_FEED_BUFFER_FRAMES
	int "Frames the laptop can send ahead (tools/feed.py)"
	default 512
	help
	  Queue between the serial parser and the replay timer (replay.c). tools/feed.py keeps
	  about 2 s queued, so this must hold 2 s at the highest rate: 400 frames at 200 Hz.
	  64 B of RAM per frame (16 channels x int32 + frame number).

config EHG_HISTORY_PACKETS
	int "Sent packets kept for gateway re-requests"
	default 256
	help
	  How far back a lost packet can still be re-sent (256 x 10 frames = 128 s at 20 Hz).
	  Older requests can't be served; counted as resend_miss (ehg_service.c).

config EHG_REQUIRE_PAIRING
	bool "Require LESC passkey pairing before the EHG service can be used"
	default n
	help
	  n (default) = open link, behaviour unchanged. y = the data CCC, the command slot and the
	  MCUmgr (OTA) service need an AUTHENTICATED, encrypted link (LE Secure Connections with a
	  passkey the board prints on the UART log). Set by the security.conf overlay
	  (firmware/build.sh --secure), which also turns on the Bluetooth security options this needs.

config EHG_PAIRING_BUTTON
	bool "Pair only while Button 2 has been pressed (Just Works), instead of a passkey from the UART log"
	depends on EHG_REQUIRE_PAIRING
	default n
	help
	  y = no passkey. The link must be ENCRYPTED (LE Secure Connections, Just Works), and the board accepts a
	  NEW pairing only for CONFIG_EHG_PAIRING_WINDOW_S seconds after Button 2 is pressed (LED3 lit); it then also
	  asks a connected central to pair. A central that is already bonded reconnects without the button.
	  Protects against passive listening and against anyone who is not at the board; it does NOT stop an active
	  man-in-the-middle during the window (Just Works has no code to compare). Set by security-button.conf
	  (firmware/build.sh --pairing-button).

config EHG_PAIRING_WINDOW_S
	int "Seconds a Button 2 press keeps pairing open"
	depends on EHG_PAIRING_BUTTON
	default 60

endmenu
